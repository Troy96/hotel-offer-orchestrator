      ]
    },
    {
      "name": "Health Check",
      "description": "Liveness probe — checks both supplier endpoints are reachable.",
      "item": [
        {
          "name": "Health — all systems up",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Probes both suppliers in parallel using a real city query. Returns UP/DEGRADED status for each. Use this before running the full collection to confirm the stack is ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Overall status is UP', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('UP');",
                  "});",
                  "",
                  "pm.test('Both suppliers report UP', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.supplierA).to.equal('UP');",
                  "    pm.expect(body.supplierB).to.equal('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Simulate Supplier Down (Optional)",
      "description": "These requests demonstrate system behaviour when a supplier is unreachable.\n\n**How to simulate:** In `docker-compose.yml`, add an environment variable to one of the supplier routes to return a 500, or temporarily comment out the supplier route handler and rebuild the API container:\n\n```\ndocker compose up --build api\n```\n\nAlternatively, point `SUPPLIER_BASE_URL` to an invalid host in the API container environment and restart.",
      "item": [
        {
          "name": "Health — with Supplier B down",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Run this after taking Supplier B down. The health check should reflect a DEGRADED status rather than crashing. The overall `status` field should not be UP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 (service still responds)', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Overall status is DEGRADED when a supplier is down', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.equal('DEGRADED');",
                  "});",
                  "",
                  "pm.test('Supplier B is reported as down', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.supplierB).to.not.equal('UP');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get hotels — with one supplier down (cached city)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" }
              ]
            },
            "description": "If Delhi was previously cached before the supplier went down, this request should still return results from Redis without triggering the workflow.\n\nThis demonstrates the resilience benefit of the cache-aside pattern — a supplier outage does not affect already-cached cities."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 — served from cache despite supplier being down', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns non-empty array from cache', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').with.length.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}