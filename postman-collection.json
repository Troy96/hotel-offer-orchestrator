              "query": [
                { "key": "city", "value": "atlantis" }
              ]
            },
            "description": "Confirms the supplier returns an empty array for an unknown city rather than an error."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
