{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Aggregate overlapping hotel offers from two mock suppliers using Temporal, Redis, and Express",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/temporal/worker.js",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:worker": "tsx apps/worker/src/worker.ts",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.5",
    "@temporalio/client": "^1.17.0",
    "@temporalio/worker": "^1.17.0",
    "@temporalio/workflow": "^1.17.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "ioredis": "^5.10.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
